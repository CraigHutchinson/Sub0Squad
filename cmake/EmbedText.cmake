# Turn text files into one C++ source that defines them as string constants, so a page or a script is edited (and tested) as its own file and still
# ships inside the binary. Run as:
#   cmake -DOUT=<file.cpp> -DNAMESPACE=<ns> "-DFILES=<name1>=<path1>|<name2>=<path2>" -P EmbedText.cmake
# Each file becomes `extern const char* const <name>` in <ns>, as a raw string literal (the delimiter is checked not to occur in the text).
if(NOT OUT OR NOT FILES OR NOT NAMESPACE)
  message(FATAL_ERROR "EmbedText.cmake needs -DOUT, -DNAMESPACE and -DFILES")
endif()
string(REPLACE "|" ";" entries "${FILES}")
set(code "// Generated by cmake/EmbedText.cmake from the files named below. Do not edit: edit the files.\nnamespace ${NAMESPACE} {\n")
foreach(entry ${entries})
  string(FIND "${entry}" "=" eq)
  string(SUBSTRING "${entry}" 0 ${eq} name)
  math(EXPR after "${eq} + 1")
  string(SUBSTRING "${entry}" ${after} -1 path)
  file(READ "${path}" text)
  string(FIND "${text}" ")S0QTEXT\"" clash)
  if(NOT clash EQUAL -1)
    message(FATAL_ERROR "${path} contains the raw string delimiter )S0QTEXT\"")
  endif()
  string(APPEND code "// ${path}\nextern const char* const ${name};\nconst char* const ${name} = R\"S0QTEXT(${text})S0QTEXT\";\n")
endforeach()
string(APPEND code "}  // namespace ${NAMESPACE}\n")
file(WRITE "${OUT}" "${code}")
