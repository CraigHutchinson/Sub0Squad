# Component layering check (docs/COMPONENTS.md): a source or header may include only its own layer or a lower one.
# Run as: cmake -DSRC_DIR=<repo> -P CheckLayers.cmake. Known upward includes are listed in KNOWN_VIOLATIONS; the list may only shrink
# (a listed violation that no longer exists is an error, so fixed ones are removed and cannot come back).
set(LAYER0 paths frame unix_socket journal job_spec job_store process_tree progress event_channel host_guard harness)
set(LAYER1 shim supervisor status mock_worker)
set(LAYER2 engine plan division policy plan_lint ledger workflow workflow_status overseer briefing recall trace triage edits qa)
set(LAYER3 harness_registry harness_web web_templates calculator_templates sandbox)
set(LAYER4 llm_agent architect optimizer replay)
set(LAYER5 daemon)
set(LAYER6 portal portal_page client sub0squad)
# "file->included-header" pairs that go upward today; each is a refactor target.
set(KNOWN_VIOLATIONS
  )

function(layer_of stem out)
  foreach(n RANGE 0 6)
    list(FIND LAYER${n} ${stem} idx)
    if(NOT idx EQUAL -1)
      set(${out} ${n} PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} -1 PARENT_SCOPE)
endfunction()

set(found "")
set(unmapped "")
file(GLOB files "${SRC_DIR}/src/*.cpp" "${SRC_DIR}/include/sub0squad/*.hpp")
foreach(f ${files})
  get_filename_component(stem "${f}" NAME_WE)
  layer_of(${stem} mine)
  if(mine EQUAL -1)
    list(APPEND unmapped ${stem})
    continue()
  endif()
  file(STRINGS "${f}" lines REGEX "^#include \"sub0squad/[a-z_0-9]+\\.hpp\"")
  foreach(l ${lines})
    string(REGEX REPLACE "^#include \"sub0squad/([a-z_0-9]+)\\.hpp\"" "\\1" inc "${l}")
    if(inc STREQUAL stem)
      continue()
    endif()
    layer_of(${inc} theirs)
    if(theirs EQUAL -1)
      list(APPEND unmapped ${inc})
    elseif(theirs GREATER mine)
      list(APPEND found "${stem}->${inc}")
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES found)
list(REMOVE_DUPLICATES unmapped)

set(bad "")
foreach(v ${found})
  list(FIND KNOWN_VIOLATIONS "${v}" idx)
  if(idx EQUAL -1)
    list(APPEND bad "new upward include: ${v}")
  endif()
endforeach()
foreach(v ${KNOWN_VIOLATIONS})
  list(FIND found "${v}" idx)
  if(idx EQUAL -1)
    list(APPEND bad "fixed, remove from KNOWN_VIOLATIONS: ${v}")
  endif()
endforeach()
if(unmapped)
  list(APPEND bad "files not assigned to a layer: ${unmapped}")
endif()
if(bad)
  string(REPLACE ";" "\n  " msg "${bad}")
  message(FATAL_ERROR "layering check failed:\n  ${msg}")
endif()
message(STATUS "layering ok (${found} known upward includes remain)")
