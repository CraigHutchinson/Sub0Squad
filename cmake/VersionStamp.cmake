# Run with cmake -P: writes build_info.hpp for the repository at SRC_DIR (see Version.cmake).
find_package(Git QUIET)
set(sha "unknown")
set(dirty "0")
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=12 HEAD WORKING_DIRECTORY ${SRC_DIR} OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no WORKING_DIRECTORY ${SRC_DIR} OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(changes)
    set(dirty "1")
  endif()
endif()
if(NOT sha)
  set(sha "unknown")
endif()
set(content "#pragma once\n#define SUB0SQUAD_GIT_SHA \"${sha}\"\n#define SUB0SQUAD_GIT_DIRTY \"${dirty}\"\n#define SUB0SQUAD_VERSION \"${VERSION}\"\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
