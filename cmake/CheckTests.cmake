# Every test program must report its failed checks: `CHECK` only counts, and `return finish();` turns the count into the exit code. A test that ends
# with `return 0;` can never fail (three did: docs/INTERVENTIONS.md row 38). Run as: cmake -DSRC_DIR=<repo> -P CheckTests.cmake.
file(GLOB tests "${SRC_DIR}/tests/test_*.cpp")
set(bad "")
foreach(t ${tests})
  file(READ "${t}" text)
  string(FIND "${text}" "CHECK" usesCheck)
  string(FIND "${text}" "return finish();" reports)
  if(NOT usesCheck EQUAL -1 AND reports EQUAL -1)
    get_filename_component(name "${t}" NAME)
    list(APPEND bad "${name}")
  endif()
endforeach()
if(bad)
  string(REPLACE ";" ", " msg "${bad}")
  message(FATAL_ERROR "these tests use CHECK but never return finish(), so they cannot fail: ${msg}")
endif()
list(LENGTH tests n)
if(n EQUAL 0)
  message(FATAL_ERROR "no test programs found under ${SRC_DIR}/tests")
endif()
message(STATUS "all ${n} test programs report their failed checks")
