{"schema":"process-1","name":"standard","version":1,"description":"Plan, build every item under the escalation ladder (retry, divide, send the tests back, rewrite the card, escalate), integrate.","stages":[{"name":"plan","kind":"job","entry":"always","exit":"plan.present","job":{"step":"planner","label":"planner","tool":"mock-planner","args":["--task","${task}","--out","${sandbox}/plan.json"],"tier":"stub","wallSeconds":60,"retries":1,"accept":"plan"}},{"name":"build","kind":"items","entry":"stage.plan.done","exit":"items.all(accepted)","leaf":{"executor":{"developer":"session","tester":"session"},"allow":{"decompose":true,"sections":true,"reviseTests":true,"rearchitect":true,"escalate":true},"wallSeconds":{"agentLlm":10800,"agentOther":120,"gate":120,"architectLlm":5400,"architectOther":120},"contractSections":true,"mends":{"enabled":true,"disabled":[]}},"ascent":{"maxRoundTrips":3}},{"name":"integrate","kind":"job","entry":"stage.build.done && !requests.openBlocking","exit":"job(integrator).succeeded","job":{"step":"integrator","label":"integration","tool":"harness:integrate","args":["--workflow-dir","${sandbox}"],"tier":"stub","wallSeconds":300,"retries":0,"accept":""}}]}
