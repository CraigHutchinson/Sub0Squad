--- want src/calc.cpp
#include <stdexcept>
#include <cmath>

double divide(double a, double d)
{
    if (d == 0) throw std::domain_error("division by zero");
    return a / d;  // checked
}

double square(double x)
{
    return std::pow(x, 2);
}
