{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Release)",
      "binaryDir": "${sourceDir}/out/build/default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "quick",
      "displayName": "Smoke tier: everything except tests labelled full (the same set as -L smoke)",
      "inherits": "default",
      "filter": { "exclude": { "label": "full" } }
    },
    {
      "name": "full",
      "displayName": "Full tier: every test, smoke and full",
      "inherits": "default"
    }
  ]
}
